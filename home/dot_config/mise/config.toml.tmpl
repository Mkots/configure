[settings]
lockfile = true

[tools]
neovim = "0.12.0"
zoxide = "0.9.9"
fastfetch = "2.61.0"
gh = "2.89.0"
starship = "1.24.2"
node = "lts"
rust = "latest"
fzf = "0.71.0"
ripgrep = "15.1.0"
fd = "10.4.2"
{{- if eq .chezmoi.os "darwin" }}
# eza publishes Linux/Windows binaries only, so build it from source here.
# Takes ~2 min and needs cargo, so the mise-install script installs rust first.
"cargo:eza" = "0.23.4"
{{- else }}
# prebuilt binary from the eza-community releases
eza = "0.23.4"
{{- end }}
